export type VariableKey = "lst" | "sea_ice" | "ndvi" | "water_extent" | "precipitation";
export type TrendShape = "up" | "down";

export type Variable = {
  key: VariableKey;
  name: string;
  shortName: string;
  unit: string;
  perDecadeUnit: string;
  description: string;
  mission: string;
};

export type Region = {
  slug: string;
  name: string;
  subtitle: string;
  climate: string;
  area: string;
  variable: VariableKey;
  center: [number, number];   // lat, lng
  bounds: [[number, number], [number, number]];  // [[south, west], [north, east]]
  zoom: number;
  teaser: string;
  trendShape: TrendShape;
  baseline: number;
  period: [number, number];
};

export type TrendStats = {
  slope: number;              // per decade
  slopeUnit: string;
  pValue: number;
  significant: boolean;
  ciLow: number;
  ciHigh: number;
  direction: "up" | "down" | "flat";
};

export type CardKind = "finding" | "trend-chart" | "slope-map" | "variable" | "caveat";

export type CanvasCard = {
  id: string;
  kind: CardKind;
  createdAt: number;
  point?: [number, number];
};

export type ChatMessage = {
  id: string;
  role: "user" | "assistant";
  text: string;
  cardKind?: CardKind;
  cardId?: string;
};

