============================================================
TREND MATH — lib/trend.ts
============================================================

generateSeries(region): number[]
  Months = (endYear - startYear + 1) * 12.
  perMonthTrend based on trendShape and variable:
    up   + lst: +0.0028; up + other: +0.0006
    down + sea_ice: -0.0008; down + water_extent: -0.0035; else -0.002
  seasonalAmp by variable:
    lst 6, sea_ice 4, precipitation 3, water_extent 1.5, other 0.8
  For each month i:
    linear = baseline + perMonthTrend * i * 10
    seasonal = seasonalAmp * sin((i/12) * 2π - π/2)
    noise = (rand() - 0.5) * seasonalAmp * 0.7   // rand from seeded(hashSlug)
    interannual = 2 * sin((i/84) * 2π) * 0.35
    push(linear + seasonal + noise + interannual)

computeStats(region, series): TrendStats
  Simple linear regression on month index vs value.
  slopePerSample = Σ((x - x̄)(y - ȳ)) / Σ(x - x̄)²
  slope = slopePerSample * 12 * 10   // per decade
  residuals, residualStd (n - 2 denominator)
  seSlope = residualStd / sqrt(Σ(x - x̄)²)
  tStat = slopePerSample / max(seSlope, 1e-9)
  pValue = exp(-abs(tStat) * 1.6)    // crude demo proxy
  ciHalf = 1.96 * seSlope * 120
  direction: abs(slope) < 0.01 ? "flat" : slope > 0 ? "up" : "down"
  significant: pValue < 0.05
  Mark clearly in a comment: "DEMO approximation — replace with real
  Mann-Kendall + Sen's slope + autocorrelation correction."

formatSlope(stats): string
  Sign, then abs(slope) with 3 decimals if < 1 else 2 decimals, then unit.
  e.g. "+0.428 °C/decade"

formatP(p): string
  "p < 0.001" if p < 0.001, else "p = " + p.toFixed(3)

slopeAtPoint(lat, lng, region): number
  Deterministic per-point slope used to color map markers:
    h = sin(lat * 12.9898 + lng * 78.233) * 43758.5453
    noise = (h - floor(h)) * 2 - 1
    base = region.trendShape === "up" ? 0.35 : -1.2
    return base + noise * 0.45

