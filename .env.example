# NASA Earthdata login (only needed for real data downloads, not for the bundled sample demo)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Hugging Face: token to push/pull model weights and call the inference API (optional)
HF_TOKEN=
# Repo that hosts trained weights, e.g. youruser/earth-pulse-models
EP_MODEL_REPO=
# RAG backend for POST /chat:
#   ollama (default)  — local Ollama re-words facts (current behaviour)
#   hf                — Hugging Face RAG Space does retrieval + generation,
#                       backend re-applies the same fact guards, then falls
#                       back to Ollama, then to templated prose
#   templated         — deterministic templated prose only
# EP_RAG_BACKEND=ollama
# Base URL of your RAG Space once created, e.g. https://<user>-earth-pulse-rag.hf.space
# (or http://localhost:7860 when testing the Space locally)
# HF_RAG_SPACE_URL=
# EP_RAG_TIMEOUT=90
# EP_RAG_KB_PATH=data/rag/kb.json   # local KB copy used only for /health stats
# EP_RAG_TOP_K=4

# Optional free-tier LLM key (Gemini). If unset, the API uses a templated plain-English fallback.
GEMINI_API_KEY=

# Local LLM (Ollama) — used by POST /chat and optionally /place narration.
# Start it with `ollama serve` and pull a model, e.g. `ollama pull qwen2.5:1.5b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# EP_LLM_BACKEND=templated   # disable the LLM entirely
# EP_EXPLAIN_LLM=1           # also use Ollama for /place explanations (slower)
# EP_LLM_TIMEOUT=90

# NASA FIRMS map key (optional). If unset, fire data is reported as unavailable.
FIRMS_MAP_KEY=

# Web frontend: base URL of the API
VITE_API_BASE=http://localhost:8000

# API host/port (optional)
HOST=0.0.0.0
PORT=8000
# API override: point the API at a DIFFERENT store (e.g., the real POWER artifact)
# EP_STORE_PATH=/abs/path/earth_pulse_power_real.npz
# EP_ANALYSIS_PATH=/abs/path/analysis_power_real.json
# EP_CACHE_TTL=3600        # Tier B cache seconds (data/cache/)
# EP_SCENARIO_IMAGES=1     # allow scenario generation (still needs GPU + ack)
# EP_SCENARIO_MODEL=runwayml/stable-diffusion-v1-5   # override diffusion model
# EP_SCENARIO_STEPS=30                                  # CPU/turbo: 4
# EP_SCENARIO_GUIDANCE=7.5                              # turbo distillation: 0.0
# EP_REQUIRE_REAL_DATA=1   # tests fail if analysis reports synthetic_demo
