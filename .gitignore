# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/

# Data artifacts (large) — keep samples dir small
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
# Rebuilt point stores and small probe caches are committed so collaborators
# get the real 10 km data without waiting for the MODIS backfill.
!data/processed/points/
!data/processed/points/*.npz
!data/processed/analysis.json
!data/cache/*.json
# sample npz is committed so the demo works offline; ignore if it grows
# data/samples/*.npz

# Model artifacts
models/artifacts/*
!models/artifacts/.gitkeep

# Node / web
node_modules/
web/dist/
web/.env
dist/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.log
*.err
data/forecasts/
data/forecasts_full/

# Evaluation artifacts (rebuild with make evaluate)
reports/*.npz
